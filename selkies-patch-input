def _patch_input_handler(content, path):
    content = replace_once(content, path, "clipboard state", INIT_OLD, INIT_NEW)
    content = replace_once(content, path, "clipboard save", INJECT_SAVE_OLD, INJECT_SAVE_NEW)
    content = replace_once(content, path, "clipboard restore", INJECT_RESTORE_OLD, INJECT_RESTORE_NEW)
    content = replace_once(content, path, "clipboard restore task", RESTORE_FN_OLD, RESTORE_FN_NEW)
    content = replace_once(content, path, "keyboard queue timeout", TIMEOUT_OLD, TIMEOUT_NEW)

    if "_build_cyrillic_qwerty_map" not in content:
        idx = content.find("\nCYRILLIC_TO_QWERTY_KEYSYM = {")
        if idx == -1:
            warn(f"Cyrillic shortcuts: anchor not found in {path} (Selkies changed, patch needs updating)")
        else:
            end_idx = content.find("\n}", idx) + 2
            content = content[:end_idx] + "\n" + CYRILLIC_BUILDER + content[end_idx:]

    content = replace_once(content, path, "unicode fallback with Ctrl", BLOCK_1_OLD, BLOCK_1_NEW)
    content = replace_once(content, path, "keysym level match", BLOCK_2_OLD, BLOCK_2_NEW)
    content = replace_once(content, path, "action modifier settle", BLOCK_3_OLD, BLOCK_3_NEW)
    content = replace_once(content, path, "Wayland modifier neutralization", WL_PRESS_RELEASE_OLD, WL_PRESS_RELEASE_NEW)
    content = replace_once(content, path, "keymap owner modifiers", OWNER_BUILD_OLD, OWNER_BUILD_NEW)
    content = replace_once(content, path, "cached keymap owner modifiers", OWNER_CACHED_OLD, OWNER_CACHED_NEW)
    content = replace_once(content, path, "XTest modifier neutralization", XTEST_OLD, XTEST_NEW)
    return content


