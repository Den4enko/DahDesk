#!/usr/bin/env python3
import glob
import os
import pwd
import re
import sys

SELKIES_ROOTS = [
    "/opt/selkies/lib/python*/site-packages/selkies",
    "/opt/selkies/lib64/python*/site-packages/selkies",
    "/usr/lib/python*/site-packages/selkies",
    "/usr/lib64/python*/site-packages/selkies",
    "/usr/local/lib/python*/site-packages/selkies",
]

problems = []


def warn(message):
    problems.append(message)
    print(f"[selkies-patch-input] Warning: {message}", file=sys.stderr)


def find_files(relative):
    found = []
    for root in SELKIES_ROOTS:
        found.extend(glob.glob(os.path.join(root, relative)))
    return found


def replace_once(content, path, name, old, new):
    """Replace `old` with `new`, or leave content alone when `new` is already in place."""
    if new in content:
        return content
    if content.count(old) != 1:
        warn(f"{name}: anchor not found in {path} (Selkies changed, patch needs updating)")
        return content
    return content.replace(old, new)


def replace_once_re(content, path, name, pattern, repl, applied):
    """Regex variant of replace_once for minified JS, where identifiers change between builds."""
    if re.search(applied, content):
        return content
    new_content, count = re.subn(pattern, repl, content)
    if count != 1:
        warn(f"{name}: anchor not found in {path} (Selkies changed, patch needs updating)")
        return content
    return new_content


def patch_file(path, apply, old_signatures=()):
    try:
        with open(path, "r", encoding="utf-8") as f:
            content = f.read()
    except OSError as e:
        warn(f"cannot read {path}: {e}")
        return
    for sig in old_signatures:
        if sig in content:
            warn(f"{path} carries patches from an older DahDesk; reinstall Selkies "
                 f"(sudo selkies-update) so it can be patched again")
            return
    new_content = apply(content, path)
    if new_content == content:
        return
    try:
        with open(path, "w", encoding="utf-8") as f:
            f.write(new_content)
        print(f"[selkies-patch-input] Patched {path}")
    except OSError as e:
        warn(f"cannot write {path}: {e}")


# --- Web client: AltGr/Ctrl on Windows clients -------------------------------
# Windows reports AltGr as ControlLeft + AltRight. Selkies holds ControlLeft
# back for 100 ms to see whether AltRight follows, which delays every Ctrl
# shortcut. Send Ctrl at once and take it back if AltRight does follow.

def _patch_core_js(content, path):
    content = replace_once_re(
        content, path, "AltGr arm",
        r"this\._altGrTimeout=setTimeout\(\(\)=>\{this\._altGrArmed=!1,"
        r"this\._sendKeyEvent\(([\w$]+)\.XK_Control_L,`ControlLeft`,!0\)\},(\d+)\);return",
        r"this._sendKeyEvent(\1.XK_Control_L,`ControlLeft`,!0),"
        r"this._altGrTimeout=setTimeout(()=>{this._altGrArmed=!1},\2);return",
        r"this\._altGrTimeout=setTimeout\(\(\)=>\{this\._altGrArmed=!1\},\d+\);return",
    )
    content = replace_once_re(
        content, path, "AltGr keydown",
        r"([\w$]+)===`AltRight`&&([\w$]+)\.timeStamp-this\._altGrCtrlTime<50\?([\w$]+)=([\w$]+)\.XK_ISO_Level3_Shift:"
        r"this\._sendKeyEvent\(\4\.XK_Control_L,`ControlLeft`,!0\)",
        r"\1===`AltRight`&&\2.timeStamp-this._altGrCtrlTime<50?"
        r"(this._sendKeyEvent(\4.XK_Control_L,`ControlLeft`,!1),\3=\4.XK_ISO_Level3_Shift):null",
        r"this\._altGrCtrlTime<50\?\(this\._sendKeyEvent\([\w$]+\.XK_Control_L,`ControlLeft`,!1\)",
    )
    content = replace_once_re(
        content, path, "AltGr keyup",
        r"this\._altGrArmed&&\(this\._altGrArmed=!1,clearTimeout\(this\._altGrTimeout\),"
        r"this\._sendKeyEvent\([\w$]+\.XK_Control_L,`ControlLeft`,!0\)\),",
        r"this._altGrArmed&&(this._altGrArmed=!1,clearTimeout(this._altGrTimeout)),",
        r"this\._altGrArmed&&\(this\._altGrArmed=!1,clearTimeout\(this\._altGrTimeout\)\),",
    )
    return content


def patch_selkies_core_js():
    # index.html loads the hashed bundle in assets/; src/ holds an identical copy
    targets = find_files("selkies_web/assets/selkies-core-*.js") + find_files("selkies_web/src/selkies-core.js")
    if not targets:
        warn("selkies-core.js not found")
    for path in targets:
        patch_file(path, _patch_core_js)


